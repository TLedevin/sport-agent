# Copy to .env for local development (git-ignored).
APP_PASSWORD=dev-password
SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
# DATABASE_URL defaults to a local SQLite file (local.db).

# Optional, local scripts only (check_garmin.py, garmin_login.py).
# Stored in plain text: keep this file on your PC only.
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=your-garmin-password
