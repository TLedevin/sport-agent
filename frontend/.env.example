# Backend URL. Defaults to http://localhost:8000 when unset.
# In production GitHub Actions sets it from the VITE_API_URL repo variable.
VITE_API_URL=http://localhost:8000

# Jawg map tiles (https://app.jawg.io). Without it the map falls back to plain OpenStreetMap.
# In production GitHub Actions sets it from the VITE_JAWG_TOKEN repo variable.
VITE_JAWG_TOKEN=
